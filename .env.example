DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=INFO
# Free public providers by default; point at self-hosted instances for production.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=fuel-route-planner/1.0 (your-email@example.com)
